// fxc inlines every call, so each function below is called from as few places as possible and
// the modes are runtime values. Otherwise every mode, subset and refinement step gets its own
// copy of the palette search, and the kernel takes minutes to compile.

struct Mode
{
    int number;
    int subsets;
    int colorBits;

    // 0 for the modes without alpha, which decode it as 255.
    int alphaBits;
    int indexBits;
    bool sharedPBit;

    // Where the mode's tables start in SolidEndpoints, or -1 where quantizing the endpoints to
    // the colour itself is already exact.
    int solidTable;
};

Mode MakeMode(int number, int subsets, int colorBits, int alphaBits, int indexBits, bool sharedPBit, int solidTable)
{
    Mode mode;
    mode.number = number;
    mode.subsets = subsets;
    mode.colorBits = colorBits;
    mode.alphaBits = alphaBits;
    mode.indexBits = indexBits;
    mode.sharedPBit = sharedPBit;
    mode.solidTable = solidTable;
    return mode;
}

Mode GetMode(int number)
{
    Mode mode = MakeMode(7, 2, 5, 5, 2, false, 6 * 256);
    if (number == 1)
        mode = MakeMode(1, 2, 6, 0, 3, true, 0);
    else if (number == 3)
        mode = MakeMode(3, 2, 7, 0, 2, false, -1);
    else if (number == 6)
        mode = MakeMode(6, 1, 7, 7, 4, false, 2 * 256);
    return mode;
}

// An endpoint's stored bits, 7 per channel from the low end, then its p-bit at bit 28. Packed
// to keep the candidates small, since they stay live through every fit.
typedef uint Endpoint;

Endpoint MakeEndpoint(int4 bits, int pbit)
{
    uint4 b = (uint4)bits;
    return b.x | b.y << 7 | b.z << 14 | b.w << 21 | (uint)pbit << 28;
}

int4 EndpointBits(Endpoint e)
{
    return (int4)((e >> uint4(0, 7, 14, 21)) & 0x7F);
}

int EndpointPBit(Endpoint e)
{
    return e >> 28;
}

// Indices hold 4 bits per pixel, whatever the mode's index size: pixels 0-7 in x, 8-15 in y.
struct Candidate
{
    int number;
    uint shape;
    float error;

    Endpoint start0;
    Endpoint end0;
    Endpoint start1;
    Endpoint end1;

    uint2 indices;
};

// A mask picking the subset's pixels out of the block. fxc can't index an array in a struct
// when writing, so the pixels stay where they are rather than being packed together.
struct Subset
{
    uint pixels;
    uint count;
    float4 sum;
};

struct SubsetFit
{
    Endpoint start;
    Endpoint end;
    uint2 indices;
    float error;
};

SubsetFit EmptyFit()
{
    SubsetFit fit;
    fit.start = 0;
    fit.end = 0;
    fit.indices = 0;
    fit.error = INFINITY;
    return fit;
}

uint GetIndex(uint2 indices, uint pixel)
{
    uint word = pixel < 8 ? indices.x : indices.y;
    return (word >> ((pixel & 7) * 4)) & 15;
}

uint2 IndexBits(uint index, uint pixel)
{
    uint shifted = index << ((pixel & 7) * 4);
    return pixel < 8 ? uint2(shifted, 0) : uint2(0, shifted);
}

int Weight(uint index, uint count)
{
    return Weights[count + index];
}

uint SolidEndpoint(int i)
{
    return (SolidEndpoints[i >> 1] >> ((i & 1) * 16)) & 0xFFFF;
}

int4 Expand(int4 value, int bits)
{
    return value << (8 - bits) | value >> (2 * bits - 8);
}

// What the decoder makes of an endpoint. Alpha has either the colour's bits or none, so every
// channel can share them, and the modes without alpha always decode it as 255.
int4 EndpointValue(Endpoint e, Mode mode)
{
    int4 value = Expand(EndpointBits(e) << 1 | EndpointPBit(e), mode.colorBits + 1);
    if (mode.alphaBits == 0)
        value.w = 255;
    return value;
}

// The block being encoded, as Color32. A static global is per thread in HLSL, so this is the
// one copy of the block that everything reads, rather than a copy per array parameter.
static uint g_Block[16];

float4 Unpack(uint c)
{
    return float4(c & 0xFF, (c >> 8) & 0xFF, (c >> 16) & 0xFF, c >> 24);
}

float4 Pixel(uint i)
{
    return Unpack(g_Block[i]);
}

// Modes without alpha always decode it as 255, so their fits only aim for that.
float4 Target(uint i, bool opaqueAlpha)
{
    float4 p = Pixel(i);
    return opaqueAlpha ? float4(p.xyz, 255) : p;
}

void Moments(uint pixels, bool opaqueAlpha, out float4 mean, out float4x4 cov)
{
    mean = 0;
    uint count = 0;
    for (uint i = 0; i < 16; i++)
    {
        if ((pixels & (1u << i)) == 0)
            continue;

        mean += Target(i, opaqueAlpha);
        count++;
    }
    mean /= count;

    cov = 0;
    for (uint j = 0; j < 16; j++)
    {
        if ((pixels & (1u << j)) == 0)
            continue;

        float4 d = Target(j, opaqueAlpha) - mean;
        cov[0] += d * d.x;
        cov[1] += d * d.y;
        cov[2] += d * d.z;
        cov[3] += d * d.w;
    }
}

// Power iteration. A block with no spread falls back to the grey axis, which still puts both
// endpoints on the block's one colour.
float4 PrincipalAxis(float4x4 cov)
{
    float4 axis = 1;
    for (int i = 0; i < 8; i++)
    {
        axis = mul(cov, axis);
        float len = length(axis);
        if (len < 1e-6)
            return 0.5;
        axis /= len;
    }
    return axis;
}

// How far a partition's subsets are from lying on a line each, measured as the variance left
// over once the principal axis is taken out. The lowest scoring partitions are tried.
float ShapeScore(uint shape)
{
    uint mask = PartitionMasks[shape];

    float score = 0;
    [loop]
    for (uint half = 0; half < 2; half++)
    {
        float4 mean;
        float4x4 cov;
        Moments(half == 0 ? ~mask & 0xFFFF : mask, false, mean, cov);

        float4 axis = PrincipalAxis(cov);
        float trace = cov[0].x + cov[1].y + cov[2].z + cov[3].w;
        score += trace - dot(axis, mul(cov, axis));
    }

    return score;
}

Subset MakeSubset(uint pixels)
{
    Subset s;
    s.pixels = pixels;
    s.count = 0;
    s.sum = 0;
    for (uint i = 0; i < 16; i++)
    {
        if ((pixels & (1u << i)) == 0)
            continue;

        s.sum += Pixel(i);
        s.count++;
    }

    return s;
}

// Each channel is stored as its top bits plus the p-bit as the lowest, and the decoder
// replicates the high bits of that into whatever is left of 8.
Endpoint Quantize(float4 e, Mode mode, int pbit)
{
    e = clamp(e, 0, 255);

    // Alpha has either the colour's bits or none, so every channel can share them.
    int bits = mode.colorBits;
    int maxValue = (1 << bits) - 1;
    int4 guess = clamp((int4)round((e * ((2 << bits) - 1) / 255.0 - pbit) * 0.5), 0, maxValue);

    int4 best = 0;
    float4 bestErr = INFINITY;
    for (int k = -1; k <= 1; k++)
    {
        // Clamping repeats an edge candidate, which can't win a second time.
        int4 c = clamp(guess + k, 0, maxValue);
        int4 value = Expand(c << 1 | pbit, bits + 1);
        float4 d = value - e;
        bool4 better = d * d < bestErr;

        bestErr = better ? d * d : bestErr;
        best = better ? c : best;
    }

    if (mode.alphaBits == 0)
        best.w = 0;

    return MakeEndpoint(best, pbit);
}

// Picks the nearest palette entry for each pixel in the subset. Every distance is a whole
// number well under 2^24, so the float sums are exact.
bool Evaluate(Subset s, Mode mode, Endpoint start, Endpoint end, inout SubsetFit fit)
{
    uint count = 1u << mode.indexBits;
    int4 startValue = EndpointValue(start, mode);
    int4 endValue = EndpointValue(end, mode);

    // Packed like the pixels, to keep the array small.
    uint palette[16];
    [loop]
    for (uint j = 0; j < count; j++)
    {
        int w = Weight(j, count);
        uint4 entry = ((64 - w) * startValue + w * endValue + 32) >> 6;
        palette[j] = entry.x | entry.y << 8 | entry.z << 16 | entry.w << 24;
    }

    float error = 0;
    uint2 indices = 0;
    [loop]
    for (uint k = 0; k < 16; k++)
    {
        if ((s.pixels & (1u << k)) == 0)
            continue;

        float4 px = Pixel(k);
        float best = INFINITY;
        uint selected = 0;
        [loop]
        for (uint e = 0; e < count; e++)
        {
            float4 d = px - Unpack(palette[e]);
            float dist = mad(d.x, d.x, mad(d.y, d.y, mad(d.z, d.z, d.w * d.w)));
            if (dist < best)
            {
                best = dist;
                selected = e;
            }
        }

        error += best;
        indices |= IndexBits(selected, k);
    }

    if (error >= fit.error)
        return false;

    fit.start = start;
    fit.end = end;
    fit.indices = indices;
    fit.error = error;
    return true;
}

// One endpoint of the pair the solid table holds for each channel of the target.
Endpoint SolidEndpointFor(Mode mode, int4 target, int table, int pbit, bool isEnd)
{
    int4 bits = 0;
    for (int ch = 0; ch < 4; ch++)
    {
        uint pair = SolidEndpoint(table + target[ch]);
        bits[ch] = isEnd ? pair >> 8 : pair & 0xFF;
    }

    if (mode.alphaBits == 0)
        bits.w = 0;

    return MakeEndpoint(bits, pbit);
}

// Tries a pair of endpoints under every p-bit combination the mode allows, or only combination
// combo if it isn't -1. With solid set, a and b are ignored, and the pairs come from the solid
// tables to put the mode's solid palette entry on the colour instead. Quantizing the endpoints
// to the colour itself only reaches the values an endpoint can hold, while an interpolated
// entry can land on nearly every value exactly.
bool Try(Subset s, Mode mode, int combo, float4 a, float4 b, bool solid, float4 color, inout SubsetFit fit)
{
    if (solid && mode.solidTable < 0)
        return false;

    int4 target = (int4)round(clamp(color, 0, 255));

    bool improved = false;
    int first = combo < 0 ? 0 : combo;
    int last = combo < 0 ? (mode.sharedPBit ? 2 : 4) : combo + 1;
    [loop]
    for (int p = first; p < last; p++)
    {
        int startPBit = mode.sharedPBit ? p : p & 1;
        int endPBit = mode.sharedPBit ? p : p >> 1;

        Endpoint start;
        Endpoint end;
        if (solid)
        {
            int table = mode.solidTable + p * 256;
            start = SolidEndpointFor(mode, target, table, startPBit, false);
            end = SolidEndpointFor(mode, target, table, endPBit, true);
        }
        else
        {
            start = Quantize(a, mode, startPBit);
            end = Quantize(b, mode, endPBit);
        }

        improved = Evaluate(s, mode, start, end, fit) || improved;
    }

    return improved;
}

// Solves for the endpoints that best reproduce the targets given these indices.
bool TryLeastSquares(Subset s, Mode mode, int combo, uint2 selected, inout SubsetFit fit)
{
    uint count = 1u << mode.indexBits;

    float sumW = 0;
    float c = 0;
    float4 d1 = 0;
    for (uint k = 0; k < 16; k++)
    {
        if ((s.pixels & (1u << k)) == 0)
            continue;

        float w = Weight(GetIndex(selected, k), count) / 64.0;
        sumW += w;
        c += w * w;
        d1 += w * Pixel(k);
    }

    float b = sumW - c;
    float a = s.count - sumW - b;
    float4 total = s.sum;

    // Modes without alpha always decode it as 255, so the fit only aims for that.
    if (mode.alphaBits == 0)
    {
        d1.w = 255.0 * sumW;
        total.w = 255.0 * s.count;
    }

    float4 d0 = total - d1;

    float det = a * c - b * b;
    if (abs(det) < 1e-6)
        return false;

    float inv = 1.0 / det;
    return Try(s, mode, combo, (c * d0 - b * d1) * inv, (a * d1 - b * d0) * inv, false, 0, fit);
}

// Variants 0-2 pull the lowest indices up, then the highest down, then both. The rest remap
// the indices as though the endpoints sat a step or so outside or inside where they are now.
#define PERTURBED_VARIANTS 11

uint2 PerturbIndices(uint2 selected, uint pixels, int maxIndex, int lo, int hi, int variant)
{
    // The remaps cover low in [-1, 1] and high in [max - 1, max + 1], skipping the identity.
    uint grid = max(variant - 3, 0);
    grid += grid >= 4 ? 1 : 0;
    int low = (int)(grid / 3) - SPREAD_STEPS;
    int high = maxIndex - 1 + (int)(grid % 3);

    uint2 result = 0;
    for (uint i = 0; i < 16; i++)
    {
        if ((pixels & (1u << i)) == 0)
            continue;

        int index = GetIndex(selected, i);
        if (variant < 3)
        {
            if (variant != 1 && index == lo && index < maxIndex)
                index++;
            else if (variant != 0 && index == hi && index > 0)
                index--;
        }
        else
        {
            float remapped = floor(maxIndex * (float)(index - low) / (high - low) + 0.5);
            index = clamp((int)remapped, 0, maxIndex);
        }

        result |= IndexBits(index, i);
    }

    return result;
}

// Fits one subset's endpoints along its principal axis, then refines them with least-squares
// passes over the chosen indices. Writes the subset's pixels into indices.
//
// The refinements after that follow bc7e: least-squares solves for the indices with their
// extremes pulled in or spread out, and fitting the subset's average as a single colour.
float FitSubset(
    uint pixels,
    Mode mode,
    int combo,
    bool fast,
    out Endpoint start,
    out Endpoint end,
    inout uint2 indices
)
{
    bool opaqueAlpha = mode.alphaBits == 0;
    SubsetFit fit = EmptyFit();
    Subset s = MakeSubset(pixels);

    float4 mean;
    float4x4 cov;
    Moments(pixels, opaqueAlpha, mean, cov);
    float4 axis = PrincipalAxis(cov);

    float minT = INFINITY;
    float maxT = -INFINITY;
    for (uint j = 0; j < 16; j++)
    {
        if ((pixels & (1u << j)) == 0)
            continue;

        float t = dot(Target(j, opaqueAlpha) - mean, axis);
        minT = min(minT, t);
        maxT = max(maxT, t);
    }

    Try(s, mode, combo, mean + axis * minT, mean + axis * maxT, false, 0, fit);

    if (maxT > minT)
    {
        int maxIndex = (1 << mode.indexBits) - 1;
        int steps = REFINE_ITERATIONS + (fast ? 0 : PERTURBED_VARIANTS);

        uint2 base = 0;
        int lo = 0;
        int hi = 0;

        // The refinement passes, then the perturbed variants of the indices they settle on.
        // Once the error reaches 0 nothing can beat it, so stopping there changes nothing.
        [loop]
        for (int step = 0; step < steps && fit.error > 0; step++)
        {
            uint2 selected = fit.indices;
            if (step >= REFINE_ITERATIONS)
            {
                if (step == REFINE_ITERATIONS)
                {
                    base = fit.indices;
                    lo = maxIndex;
                    hi = 0;
                    for (uint k = 0; k < 16; k++)
                    {
                        if ((pixels & (1u << k)) == 0)
                            continue;

                        int index = GetIndex(base, k);
                        lo = min(lo, index);
                        hi = max(hi, index);
                    }
                }

                selected = PerturbIndices(base, pixels, maxIndex, lo, hi, step - REFINE_ITERATIONS);
            }

            // The refinement passes stop as soon as one fails to improve the fit.
            if (!TryLeastSquares(s, mode, combo, selected, fit) && step < REFINE_ITERATIONS)
                step = REFINE_ITERATIONS - 1;
        }
    }

    if (fit.error > 0)
        Try(s, mode, combo, 0, 0, true, mean, fit);

    start = fit.start;
    end = fit.end;
    indices |= fit.indices;
    return fit.error;
}

Candidate EmptyCandidate(int number, uint shape)
{
    Candidate candidate;
    candidate.number = number;
    candidate.shape = shape;
    candidate.error = 0;
    candidate.start0 = 0;
    candidate.end0 = 0;
    candidate.start1 = 0;
    candidate.end1 = 0;
    candidate.indices = 0;
    return candidate;
}

Candidate EncodeShape(Mode mode, int combo, uint shape, bool fast)
{
    Candidate candidate = EmptyCandidate(mode.number, shape);

    uint mask = mode.subsets == 2 ? PartitionMasks[shape] : 0;

    [loop]
    for (int subset = 0; subset < mode.subsets; subset++)
    {
        Endpoint start;
        Endpoint end;
        candidate.error += FitSubset(
            subset == 0 ? ~mask & 0xFFFF : mask,
            mode,
            combo,
            fast,
            start,
            end,
            candidate.indices
        );

        if (subset == 0)
        {
            candidate.start0 = start;
            candidate.end0 = end;
        }
        else
        {
            candidate.start1 = start;
            candidate.end1 = end;
        }
    }

    return candidate;
}

uint2 Invert(uint2 indices, uint pixels, uint count)
{
    for (uint i = 0; i < 16; i++)
    {
        if ((pixels & (1u << i)) == 0)
            continue;

        uint inverted = count - 1 - GetIndex(indices, i);
        indices &= ~IndexBits(15, i);
        indices |= IndexBits(inverted, i);
    }

    return indices;
}

struct BitWriter
{
    uint4 words;
    uint pos;
};

void Write(inout BitWriter writer, uint value, uint bits)
{
    uint word = writer.pos >> 5;
    uint offset = writer.pos & 31;
    uint4 lane = uint4(0, 1, 2, 3);

    writer.words |= lane == word ? value << offset : 0;
    if (offset + bits > 32)
        writer.words |= lane == word + 1 ? value >> (32 - offset) : 0;

    writer.pos += bits;
}

uint EndpointChannel(Endpoint e, int ch)
{
    return (e >> (ch * 7)) & 0x7F;
}

uint4 Pack(Candidate c)
{
    Mode mode = GetMode(c.number);
    uint count = 1u << mode.indexBits;
    uint mask = mode.subsets == 2 ? PartitionMasks[c.shape] : 0;
    int anchor1 = mode.subsets == 2 ? (int)PartitionAnchors[c.shape] : -1;

    // Each subset's anchor is stored without its top bit, so it has to be in the lower half.
    // Swapping a subset's endpoints turns its index i into count - 1 - i.
    if (GetIndex(c.indices, 0) >= count / 2)
    {
        Endpoint swap = c.start0;
        c.start0 = c.end0;
        c.end0 = swap;
        c.indices = Invert(c.indices, ~mask & 0xFFFF, count);
    }

    if (anchor1 >= 0 && GetIndex(c.indices, anchor1) >= count / 2)
    {
        Endpoint swap = c.start1;
        c.start1 = c.end1;
        c.end1 = swap;
        c.indices = Invert(c.indices, mask, count);
    }

    BitWriter writer;
    writer.words = 0;
    writer.pos = 0;

    Write(writer, 1u << mode.number, mode.number + 1);
    if (mode.subsets == 2)
        Write(writer, c.shape, 6);

    int channels = mode.alphaBits > 0 ? 4 : 3;
    for (int ch = 0; ch < channels; ch++)
    {
        int bits = ch < 3 ? mode.colorBits : mode.alphaBits;

        Write(writer, EndpointChannel(c.start0, ch), bits);
        Write(writer, EndpointChannel(c.end0, ch), bits);
        if (mode.subsets == 2)
        {
            Write(writer, EndpointChannel(c.start1, ch), bits);
            Write(writer, EndpointChannel(c.end1, ch), bits);
        }
    }

    if (mode.sharedPBit)
    {
        Write(writer, EndpointPBit(c.start0), 1);
        Write(writer, EndpointPBit(c.start1), 1);
    }
    else
    {
        Write(writer, EndpointPBit(c.start0), 1);
        Write(writer, EndpointPBit(c.end0), 1);
        if (mode.subsets == 2)
        {
            Write(writer, EndpointPBit(c.start1), 1);
            Write(writer, EndpointPBit(c.end1), 1);
        }
    }

    for (int i = 0; i < 16; i++)
    {
        int bits = i == 0 || i == anchor1 ? mode.indexBits - 1 : mode.indexBits;
        Write(writer, GetIndex(c.indices, i), bits);
    }

    return writer.words;
}

// Small mip levels can end partway through a block, so the edge pixels fill the rest.
void LoadBlock(uint2 block)
{
    for (uint y = 0; y < 4; y++)
    {
        uint row = _PixelOffset + (min(block.y * 4 + y, _ResY - 1) - _BlockRowOffset * 4) * _ResX;
        for (uint x = 0; x < 4; x++)
            g_Block[y * 4 + x] = _Pixels[row + min(block.x * 4 + x, _ResX - 1)];
    }
}

// The fast setting follows bc7e's fastest preset: mode 6 only, with solid blocks sent straight
// to the fit that puts a palette entry on their colour.
uint4 EncodeFast()
{
    bool solid = true;
    for (uint i = 0; i < 16; i++)
        solid = solid && g_Block[i] == g_Block[0];

    Mode mode = GetMode(6);
    Candidate best = EmptyCandidate(6, 0);
    if (solid)
    {
        Subset s = MakeSubset(0xFFFF);
        SubsetFit fit = EmptyFit();
        Try(s, mode, -1, 0, 0, true, Pixel(0), fit);

        best.error = fit.error;
        best.start0 = fit.start;
        best.end0 = fit.end;
        best.indices = fit.indices;
    }
    else
    {
        best.error = FitSubset(0xFFFF, mode, -1, true, best.start0, best.end0, best.indices);
    }

    return Pack(best);
}

// Each thread encodes the block at its xy, offset by _BlockRowOffset rows, so the dispatch
// covers ceil(blocks / 8) groups on each axis.
[numthreads(8, 8, 1)]
void EncodeBC7Fast(uint3 id : SV_DispatchThreadID)
{
    uint2 block = uint2(id.x, id.y + _BlockRowOffset);

    uint blocksX = (_ResX + 3) / 4;
    if (block.x >= blocksX || block.y >= _BlockRowEnd)
        return;

    LoadBlock(block);
    _Blocks[_BlockOffset + id.y * blocksX + block.x] = EncodeFast();
}

// The full setting spreads each block over LANES threads, one per candidate shape, so that a
// thread's work is short enough for the SMs to keep plenty of them in flight.
#define LANES SHAPE_CANDIDATES
#define BLOCKS_PER_GROUP (64 / LANES)

groupshared float gs_Scores[BLOCKS_PER_GROUP * PARTITION_COUNT];
groupshared float gs_Errors[64];
groupshared uint4 gs_Encoded[64];

// The partition the block's scores rank n-th, with ties going to the lower index.
uint NthShape(uint scores, uint n)
{
    [loop]
    for (uint p = 0; p < PARTITION_COUNT; p++)
    {
        float score = gs_Scores[scores + p];
        uint rank = 0;
        [loop]
        for (uint q = 0; q < PARTITION_COUNT; q++)
        {
            float other = gs_Scores[scores + q];
            rank += other < score || (other == score && q < p) ? 1 : 0;
        }

        if (rank == n)
            return p;
    }

    return 0;
}

// Every lane tries modes 1, 3 and 7 on the shape of its rank, with 7 skipped for opaque blocks
// since 1 and 3 cover those. The first four lanes also try mode 6, each with one of its p-bit
// combinations, which takes about as long as one of the others. Each candidate is packed as
// soon as it wins, so only its encoding stays live through the fits after it.
void EncodeLane(uint scores, uint lane, out float error, out uint4 encoded)
{
    bool opaque = true;
    for (uint i = 0; i < 16; i++)
        opaque = opaque && g_Block[i] >> 24 == 255;

    uint shape = NthShape(scores, lane);

    error = INFINITY;
    encoded = 0;

    uint items = lane < 4 ? 4 : 3;
    [loop]
    for (uint item = 0; item < items; item++)
    {
        if (item == 2 && opaque)
            continue;

        bool six = item == 3;
        int number = six ? 6 : item == 0 ? 1 : item == 1 ? 3 : 7;
        Candidate candidate = EncodeShape(GetMode(number), six ? (int)lane : -1, six ? 0 : shape, false);
        if (candidate.error < error)
        {
            error = candidate.error;
            encoded = Pack(candidate);
        }
    }
}

// Each group covers BLOCKS_PER_GROUP consecutive blocks of the dispatch, row-major from
// _BlockRowOffset, so the dispatch covers ceil(blocks / BLOCKS_PER_GROUP) groups along x. Every
// thread has to reach the barriers, so the ones past the last block run through them too.
[numthreads(64, 1, 1)]
void EncodeBC7(uint3 group : SV_GroupID, uint thread : SV_GroupIndex)
{
    uint slot = thread / LANES;
    uint lane = thread % LANES;
    uint scores = slot * PARTITION_COUNT;

    uint blocksX = (_ResX + 3) / 4;
    uint index = group.x * BLOCKS_PER_GROUP + slot;
    uint2 block = uint2(index % blocksX, index / blocksX + _BlockRowOffset);
    bool valid = block.y < _BlockRowEnd;

    LoadBlock(uint2(block.x, min(block.y, _BlockRowEnd - 1)));

    for (uint shape = lane; shape < PARTITION_COUNT; shape += LANES)
        gs_Scores[scores + shape] = ShapeScore(shape);

    GroupMemoryBarrierWithGroupSync();

    float error = INFINITY;
    uint4 encoded = 0;
    if (valid)
        EncodeLane(scores, lane, error, encoded);

    gs_Errors[thread] = error;
    gs_Encoded[thread] = encoded;

    GroupMemoryBarrierWithGroupSync();

    if (!valid || lane != 0)
        return;

    uint winner = thread;
    for (uint other = thread + 1; other < thread + LANES; other++)
    {
        if (gs_Errors[other] < gs_Errors[winner])
            winner = other;
    }

    _Blocks[_BlockOffset + index] = gs_Encoded[winner];
}
