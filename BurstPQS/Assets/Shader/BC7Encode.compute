// BC7 encoder covering modes 1, 3, 6 and 7. A port of BurstPQS.Util.Textures.BC7, with each
// 4x4 block spread over several threads.
//
// EncodeBC7Fast follows bc7e's fastest preset, which only tries mode 6.

#pragma kernel EncodeBC7
#pragma kernel EncodeBC7Fast

// Each dispatch covers a run of whole block rows, and has a slot of its own in each buffer, so
// that several can be in flight at once.

// Color32 pixels with red in the low byte. The dispatch's pixel rows, starting at pixel row
// _BlockRowOffset * 4, are stored row-major from element _PixelOffset.
StructuredBuffer<uint> _Pixels;

// One block per element with the low 64 bits in xy. The dispatch's blocks are stored row-major
// from element _BlockOffset.
RWStructuredBuffer<uint4> _Blocks;

// The size of the whole level.
uint _ResX;
uint _ResY;

// The first block row this dispatch covers, counted from the top of the level.
uint _BlockRowOffset;

// One past the last block row this dispatch covers. Its groups can run past it, onto rows the
// slot doesn't hold.
uint _BlockRowEnd;

uint _PixelOffset;
uint _BlockOffset;

#define SHAPE_CANDIDATES 8
#define PARTITION_COUNT 64
#define REFINE_ITERATIONS 2
#define SPREAD_STEPS 1
#define INFINITY asfloat(0x7F800000)

// The interpolation weights for each palette size, starting at the palette size so that
// count + index finds them.
static const uint Weights[32] =
{
    0, 0, 0, 0, 0, 21, 43, 64, 0, 9, 18, 27, 37, 46, 55, 64,
    0, 4, 9, 13, 17, 21, 26, 30, 34, 38, 43, 47, 51, 55, 60, 64
};

// The partitions for the two-subset modes, as given by the D3D11 BC7 specification. Bit i is
// set when pixel i belongs to the second subset.
static const uint PartitionMasks[PARTITION_COUNT] =
{
    0xCCCC, 0x8888, 0xEEEE, 0xECC8, 0xC880, 0xFEEC, 0xFEC8, 0xEC80,
    0xC800, 0xFFEC, 0xFE80, 0xE800, 0xFFE8, 0xFF00, 0xFFF0, 0xF000,
    0xF710, 0x008E, 0x7100, 0x08CE, 0x008C, 0x7310, 0x3100, 0x8CCE,
    0x088C, 0x3110, 0x6666, 0x366C, 0x17E8, 0x0FF0, 0x718E, 0x399C,
    0xAAAA, 0xF0F0, 0x5A5A, 0x33CC, 0x3C3C, 0x55AA, 0x9696, 0xA55A,
    0x73CE, 0x13C8, 0x324C, 0x3BDC, 0x6996, 0xC33C, 0x9966, 0x0660,
    0x0272, 0x04E4, 0x4E40, 0x2720, 0xC936, 0x936C, 0x39C6, 0x639C,
    0x9336, 0x9CC6, 0x817E, 0xE718, 0xCCF0, 0x0FCC, 0x7744, 0xEE22
};

// The second subset's anchor pixel, whose index is stored without its top bit. The first
// subset's anchor is always pixel 0.
static const uint PartitionAnchors[PARTITION_COUNT] =
{
    15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15,
    15, 2, 8, 2, 2, 8, 8, 15, 2, 8, 2, 2, 8, 8, 2, 2,
    15, 15, 6, 8, 2, 8, 15, 15, 2, 8, 2, 2, 2, 15, 15, 6,
    6, 2, 6, 8, 15, 15, 2, 2, 15, 15, 15, 15, 15, 2, 2, 15
};

